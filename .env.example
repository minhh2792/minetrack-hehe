# ===========================================
# Minetrack Configuration
# Copy this file to .env and edit as needed
# ===========================================

# Server settings
PORT=8080
HOST=0.0.0.0

# Site settings
SITE_TITLE=Minetrack

# Ping settings (milliseconds)
PING_INTERVAL=3000
PING_TIMEOUT=2500

# Graph settings
# How long to show history graph (default: 24 hours in ms)
GRAPH_DURATION=86400000
GRAPH_DURATION_LABEL=24h
# How long to show mini per-server graph (default: 3 minutes in ms)
SERVER_GRAPH_DURATION=180000

# SRV record skip timeout (0 to disable, default: 1 hour in ms)
SKIP_SRV_TIMEOUT=3600000

# Logging
LOG_LEVEL=info
LOG_FILE=minetrack.log
LOG_FAILED_PINGS=false

# InfluxDB settings
# Set INFLUXDB_ENABLED=true to enable InfluxDB integration
INFLUXDB_ENABLED=false
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=change-me-to-a-secure-token
INFLUXDB_ORG=minetrack
INFLUXDB_BUCKET=minetrack

# InfluxDB mode:
#   write - ping servers and write data to InfluxDB (default)
#   read  - only read from InfluxDB, no pinging
INFLUXDB_MODE=write

# InfluxDB admin credentials (used by docker-compose for initial setup)
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-to-a-secure-password
