{
  "name": "minetrack",
  "version": "6.0.0",
  "description": "A Minecraft server tracker - refactored with BunJS, ElysiaJS, React, TypeScript, and InfluxDB",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build:frontend": "cd frontend && bun run build",
    "build": "bun run build:frontend",
    "lint": "cd frontend && bun run lint"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.7",
    "@influxdata/influxdb-client": "^1.35.0",
    "@types/mime-types": "^3.0.1",
    "elysia": "^1.4.27",
    "mcpe-ping-fixed": "^0.0.3",
    "mcping-js": "^1.5.0",
    "mime-types": "^3.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
